{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kanadhiayash/shiroe/main/registry/shiroe-registry.schema.json",
  "title": "Shiroe Registry",
  "description": "Structural schema for shiroe-registry.json. Encodes the shapes scripts/shiroe-validate.py and shiroe/release/checks.py already enforce at runtime (registry-vs-disk parity across skills/agents/commands/team_packs/gates) — this file does not add new policy.",
  "type": "object",
  "required": ["$schema", "version", "generated", "skills", "agents", "commands", "team_packs", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment_privacy_audit": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][\\w.\\-]+)?$"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "triggers", "deliverables", "risk_level", "support_skills", "reasoning_class", "status"],
        "properties": {
          "skill": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "risk_level": { "type": "string" },
          "support_skills": { "type": "array", "items": { "type": "string" } },
          "reasoning_class": {
            "type": "string",
            "enum": ["fast", "balanced", "deep", "frontier", "local", "private"]
          },
          "status": {
            "type": "string",
            "enum": ["runtime", "adapter", "contract", "experimental"]
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "path", "runtime_backed", "role", "status"],
        "properties": {
          "agent": { "type": "string" },
          "path": { "type": "string", "pattern": "^agents/.+\\.md$" },
          "runtime_backed": { "type": "boolean" },
          "role": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["runtime", "adapter", "contract", "experimental"]
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "path", "status"],
        "properties": {
          "command": { "type": "string" },
          "path": { "type": "string", "pattern": "^commands/.+\\.md$" },
          "status": {
            "type": "string",
            "enum": ["runtime", "adapter", "contract", "experimental"]
          }
        }
      }
    },
    "team_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack", "type", "path", "status"],
        "properties": {
          "pack": { "type": "string" },
          "type": { "type": "string", "enum": ["role", "profile"] },
          "path": { "type": "string", "pattern": "^team-packs/.+\\.md$" },
          "status": {
            "type": "string",
            "enum": ["runtime", "adapter", "contract", "experimental"]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "path", "status"],
        "properties": {
          "gate": { "type": "string" },
          "path": { "type": "string", "pattern": "^shiroe/guards/.+\\.py$" },
          "status": {
            "type": "string",
            "enum": ["runtime", "adapter", "contract", "experimental"]
          }
        }
      }
    }
  }
}
